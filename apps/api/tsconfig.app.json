{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "strictPropertyInitialization": false
  },
  "include": [
    "src/**/*.ts",
    "../../libs/shared/model/src/lib/dto/measurement.dto.ts",
    "src/dto/update-user.dto.ts",
    "src/dto/create-user.dto.ts",
    "../../libs/shared/model/src/lib/model/Access-token.ts"
  ],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
